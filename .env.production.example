# Production settings for docker-compose.prod.yml. Copy to .env on the server:
#   cp .env.production.example .env
# Then fill in every value marked "change me". Never commit the real .env.

APP_NAME=DocChat
APP_ENV=production
# Generate with: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The public URL, matching DOCCHAT_DOMAIN below.
APP_URL=https://change-me.sslip.io

# Hostname Caddy serves and gets a certificate for, for example 203.0.113.10.sslip.io.
DOCCHAT_DOMAIN=change-me.sslip.io

LOG_CHANNEL=stderr
LOG_LEVEL=info

# n8n (automations) at https://n8n.<DOCCHAT_DOMAIN>, unless you set N8N_DOMAIN.
# Both values: openssl rand -base64 24. Keep N8N_ENCRYPTION_KEY forever:
# n8n encrypts its saved credentials with it.
# N8N_DOMAIN=n8n.change-me.sslip.io
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me

# Postgres in the db container. Use a long random password.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docchat
DB_USERNAME=docchat
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
FILESYSTEM_DISK=local

# No mail server on the free setup: password-reset and verification mails go
# to the log. Verify the first user with:
#   docker compose -f docker-compose.prod.yml exec app php artisan tinker --execute="App\Models\User::first()->markEmailAsVerified();"
# Email (invites, verification, password reset). "log" writes emails to
# storage/logs instead of sending them. Free SMTP options are in deploy.md.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- DocChat providers (free tiers). Keys come from:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
#   OpenRouter (optional): https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

DOCCHAT_EMBEDDING_DRIVER=gemini
DOCCHAT_EMBEDDING_MODEL=gemini-embedding-2
DOCCHAT_EMBEDDING_DIMENSIONS=1536
DOCCHAT_CHAT_DRIVER=groq
DOCCHAT_GROQ_MODEL=openai/gpt-oss-20b
DOCCHAT_GROQ_REASONING_EFFORT=low
DOCCHAT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DOCCHAT_CHAT_MAX_OUTPUT_TOKENS=800
DOCCHAT_CHAT_RATE_LIMIT_PER_MINUTE=20
DOCCHAT_RAG_TOP_K=5
DOCCHAT_RAG_SIMILARITY_THRESHOLD=0.5
DOCCHAT_RAG_HISTORY_MESSAGES=4
