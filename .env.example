APP_NAME=DocChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose host ports: change these if they clash with Laragon.
APP_PORT=8000
VITE_PORT=5173
VITE_HMR_HOST=localhost
DB_FORWARD_PORT=5432

# Postgres 16 + pgvector. Inside Docker Compose the host is the db service.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docchat
DB_USERNAME=docchat
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Seconds before a running queue job is treated as stuck and retried. Must stay
# above the longest job timeout (IngestDocumentJob: 300 s) or a job can run twice.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset mail is written to storage/logs/laravel.log in local development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# DocChat providers and RAG tuning. No API key is needed to run the tests.
# ---------------------------------------------------------------------------

# Embedding provider: Gemini via Google AI Studio.
DOCCHAT_EMBEDDING_DRIVER=gemini
# Gemini embedding model id (128-3072 dims supported; 1536 keeps HNSW indexable).
DOCCHAT_EMBEDDING_MODEL=gemini-embedding-2
# Embedding vector size. Changing it means re-embedding every document.
DOCCHAT_EMBEDDING_DIMENSIONS=1536
# Gemini API base URL.
DOCCHAT_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Chunks per :batchEmbedContents call; lower it if the free tier returns 429.
DOCCHAT_EMBEDDING_BATCH_SIZE=50
# Maximum attempts (including the first) for Gemini 429/5xx responses.
DOCCHAT_EMBEDDING_MAX_RETRIES=5
# Base delay for exponential backoff in milliseconds.
DOCCHAT_EMBEDDING_RETRY_BASE_MS=1000
# Prefix Gemini expects in front of a search query.
DOCCHAT_EMBEDDING_QUERY_PREFIX="task: search result | query: "
# Prefix Gemini expects in front of a document chunk; {title} is replaced.
DOCCHAT_EMBEDDING_DOCUMENT_PREFIX="title: {title} | text: "
# Google AI Studio API key (aistudio.google.com). Never commit a real key.
GEMINI_API_KEY=

# Chat provider: groq, openrouter or gemini.
DOCCHAT_CHAT_DRIVER=groq
# Hard cap on generated answer tokens (Groq's free tier is token-limited).
DOCCHAT_CHAT_MAX_OUTPUT_TOKENS=800
# Seconds to wait for a streamed answer before giving up.
DOCCHAT_CHAT_TIMEOUT_SECONDS=120
# Chat questions allowed per user per minute.
DOCCHAT_CHAT_RATE_LIMIT_PER_MINUTE=20
# Groq model id and OpenAI-compatible base URL.
DOCCHAT_GROQ_MODEL=openai/gpt-oss-20b
DOCCHAT_GROQ_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss reasoning effort: low, medium or high. Low keeps the 8K tokens/minute
# free budget for the answer; reasoning text is never shown or stored.
DOCCHAT_GROQ_REASONING_EFFORT=low
# Groq API key (console.groq.com). Never commit a real key.
GROQ_API_KEY=
# OpenRouter model id. Pinned from https://openrouter.ai/collections/free-models
# on 2026-11-24 (the free list changes monthly; nvidia/nemotron-3.5-lightning:free
# is a faster alternative). Never use openrouter/free: it picks a random model.
DOCCHAT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DOCCHAT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter API key (openrouter.ai). Never commit a real key.
OPENROUTER_API_KEY=
# Optional attribution headers OpenRouter shows on its dashboard.
DOCCHAT_OPENROUTER_REFERER="${APP_URL}"
DOCCHAT_OPENROUTER_TITLE="${APP_NAME}"

# Gemini chat model for workspaces that bring their own Gemini key (and for
# DOCCHAT_CHAT_DRIVER=gemini). Pick an id from Google AI Studio's model list.
DOCCHAT_GEMINI_CHAT_MODEL=
# Gemini thinking effort: low, medium or high (none turns it off on 2.5 models).
DOCCHAT_GEMINI_REASONING_EFFORT=low
# Let workspace owners bring their own free Groq or Gemini key (Workspace > AI keys).
DOCCHAT_OWN_KEYS=true

# AI in the browser: the server searches, the asker's browser writes the answer.
DOCCHAT_DEVICE_AI=true
# Chunks sent to on-device models (they have small context windows).
DOCCHAT_DEVICE_TOP_K=3
# WebLLM fallback on the chat page, loaded from a CDN only when picked.
DOCCHAT_WEBLLM_URL=https://cdn.jsdelivr.net/npm/@mlc-ai/web-llm@0.2.87/+esm
DOCCHAT_WEBLLM_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC

# Number of chunks retrieved per question.
DOCCHAT_RAG_TOP_K=5
# Minimum cosine similarity (0-1) before a chunk is usable.
DOCCHAT_RAG_SIMILARITY_THRESHOLD=0.5
# Previous chat messages included for follow-up questions.
DOCCHAT_RAG_HISTORY_MESSAGES=4

# Seconds docchat:eval waits between chat calls (Groq free tier: 8K tokens/minute).
DOCCHAT_EVAL_DELAY_SECONDS=8

# Target chunk size in estimated tokens.
DOCCHAT_CHUNK_TOKENS=800
# Fractional overlap between consecutive chunks.
DOCCHAT_CHUNK_OVERLAP=0.15
# Characters per token used by the chunker's estimate.
DOCCHAT_CHARS_PER_TOKEN=4
# Maximum upload size in kilobytes (10 MB).
DOCCHAT_MAX_UPLOAD_KB=10240

VITE_APP_NAME="${APP_NAME}"

# Token-saving caches (database only, no extra service)
DOCCHAT_ANSWER_CACHE=true
DOCCHAT_ANSWER_CACHE_SIMILARITY=0.95
DOCCHAT_ANSWER_CACHE_TTL_DAYS=7
DOCCHAT_QUERY_EMBEDDING_CACHE=true

# n8n workflows (docker compose only, see n8n/README.md)
# N8N_WEBHOOK_URL=http://localhost:5678/
# DocChat as n8n sees it. When DocChat runs in Laragon, use http://host.docker.internal:8000
# DOCCHAT_API_URL=http://app:8080
# How DocChat reaches n8n. When DocChat runs in Laragon, use http://localhost:5678
# DOCCHAT_CALLBACK_BASE_URL=http://n8n:5678
# DOCCHAT_WEBHOOK_SECRET=
# DOCCHAT_NOTIFY_EMAIL=

# Shared chat bots (see n8n/README.md). The bot's username without @, and the
# signed webhook that tells the bot's workflow when a file sent in a chat is ready.
TELEGRAM_BOT_USERNAME=
DOCCHAT_CHANNEL_WEBHOOK_URL=http://n8n:5678/webhook/{channel}-docchat
DOCCHAT_CHANNEL_WEBHOOK_SECRET=

# WhatsApp business number for the Chat apps page (digits with country code)
WHATSAPP_NUMBER=
# Discord (docs/discord.md)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Calling agent and voice notes (docs/calls.md). Speech to text uses Groq's free
# Whisper with GROQ_API_KEY.
DOCCHAT_STT_DRIVER=groq
DOCCHAT_STT_MODEL=whisper-large-v3-turbo
# Speech to text requests per workspace per day (Groq's free tier allows 2,000 in all).
DOCCHAT_STT_DAILY_LIMIT=300
# Spoken replies to voice notes in Telegram and WhatsApp (Groq Orpheus, 100 a day free; needs ffmpeg).
DOCCHAT_VOICE_REPLIES=false
# groq (Orpheus) or kokoro (the self-hosted voice below).
DOCCHAT_TTS_DRIVER=groq
DOCCHAT_TTS_VOICE=hannah
# Kokoro, a free natural voice you host yourself: docker compose --profile voice up -d kokoro
# Then pick it on Workspace > Calls. Empty keeps calls on browser and Twilio voices.
DOCCHAT_KOKORO_URL=
DOCCHAT_KOKORO_VOICE=af_heart
# Voice clones (Kyutai Pocket TTS), free and self-hosted: docker compose --profile clone up -d voice-clone
# Needs a free Hugging Face account that accepted the model's terms, and HF_TOKEN for the service.
# A voice is only cloned from the speaker's own recorded consent. One language per server (en, es, fr, de).
DOCCHAT_CLONE_URL=
DOCCHAT_CLONE_LANGUAGE=en
HF_TOKEN=
DOCCHAT_CALL_MAX_MINUTES=10
DOCCHAT_CALLING_HOURS=09:00-20:00
DOCCHAT_CALLING_TIMEZONE=UTC
# Twilio trial phone line. Put the keys only here, never in git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The public https address Twilio reaches, when it is not APP_URL (for example a tunnel).
TWILIO_WEBHOOK_BASE_URL=
# Voices and languages are set per workspace on Workspace > Calls.
