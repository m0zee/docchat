      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Decides what to do with each incoming WhatsApp message.\n// Status updates (sent, delivered, read) are ignored.\nconst value = $json;\nconst message = (value.messages || [])[0];\nif (!message) return { json: { route: 'ignore' } };\n\nconst text = String(message.text?.body || message.document?.caption || '').trim();\nconst [first = '', ...rest] = text.split(/\\s+/);\nconst word = first.toLowerCase().replace(/^\\//, '');\n\nlet route = 'ask';\nif (message.type === 'document') route = 'document';\nelse if (message.type === 'audio') route = 'voice';\nelse if (message.type !== 'text') route = 'unsupported';\nelse if (word === 'link' && rest[0]) route = 'link';\nelse if (word === 'help' || word === 'start') route = 'help';\nelse if (word === 'new' && rest.length === 0) route = 'new';\nelse if (word === 'unlink' && rest.length === 0) route = 'unlink';\n\nreturn {\n  json: {\n    route,\n    wa_id: String(message.from),\n    phone_number_id: String(value.metadata?.phone_number_id || ''),\n    link: `whatsapp:${message.from}`,\n    code: rest[0] || null,\n    question: text,\n    label: value.contacts?.[0]?.profile?.name || String(message.from),\n    media_id: message.document?.id || message.audio?.id || null,\n    file_name: message.document?.filename || 'document',\n  },\n};"
      },
