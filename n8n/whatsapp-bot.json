      "id": "8bd91556-a5e4-5a7d-9a4d-96b44434f521",
      "name": "DocChat documents",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        900
      ],
      "webhookId": "fe66a844-b8cc-55e0-baa5-a00eaa1fe884"
