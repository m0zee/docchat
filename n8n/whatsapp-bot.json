    {
      "parameters": {
        "jsCode": "// Checks DocChat's signature: HMAC-SHA256 of the exact raw body with the\n// webhook secret, plus a 5 minute window on the timestamp against replays.\nconst crypto = require('crypto');\nconst secret = $env.DOCCHAT_CHANNEL_WEBHOOK_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nlet raw = '';\nif (item.binary && item.binary.data) {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n}\nconst signature = String(headers['x-docchat-signature'] || '');\nconst timestamp = String(headers['x-docchat-timestamp'] || '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', String(secret || '')).update(raw).digest('hex');\nlet body = null;\ntry { body = JSON.parse(raw); } catch (error) { body = null; }\nconst fresh = /^\\d+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst valid = Boolean(secret)\n  && signature.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected))\n  && fresh\n  && body !== null\n  && String(body.timestamp) === timestamp;\n\nconst document = valid ? body?.data?.document : null;\nreturn [{ json: { valid, document } }];"
      },
