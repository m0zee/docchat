    {
      "parameters": {
        "jsCode": "// Turns each DocChat response into WhatsApp text messages.\nconst notLinked = 'This chat is not linked to a DocChat workspace yet. In DocChat, open *Workspace > Chat apps*, create a link code, and send it here as: link CODE';\nconst help = [\n  '*DocChat*',\n  'Ask a question about the documents and I answer with sources.',\n  '',\n  'link CODE: link this chat (code from Workspace > Chat apps)',\n  'new: start a new conversation',\n  'unlink: unlink this chat',\n  '',\n  'Send a PDF, TXT or Markdown file to add it.',\n  'Send a voice message to ask by voice.',\n].join('\\n');\nconst out = [];\n\n$input.all().forEach((item, index) => {\n  const from = $('Route').itemMatching(index).json;\n  const status = item.json.statusCode;\n  const body = item.json.body || {};\n  const error = body.error || {};\n  let texts;\n\n  if (from.route === 'help') texts = [help];\n  else if (from.route === 'unsupported') texts = ['I can read text and voice messages, and PDF, TXT or Markdown files.'];\n  else if (error.code === 'chat_not_linked') texts = [notLinked];\n  else if (from.route === 'voice' && error.code === 'no_speech') texts = ['I could not hear any words in that voice message.'];\n  else if (status === 429 || error.code === 'model_busy' || error.code === 'rate_limited' || error.code === 'speech_busy') texts = ['The model is busy. Try again in a minute.'];\n  else if (from.route === 'link') texts = [status === 200 ? `Linked to *${body.data.workspace.name}*. Ask me anything about its documents.` : 'That code did not work. It may be used or older than 15 minutes. Create a new one in DocChat.'];\n  else if (from.route === 'new') texts = ['Started a new conversation.'];\n  else if (from.route === 'unlink') texts = [body.data?.was_linked ? 'This chat is unlinked.' : 'This chat was not linked.'];\n  else if (from.route === 'document') texts = [status === 202 ? `Got *${from.file_name}*. I will tell you when it is ready.` : `I could not take that file: ${Object.values(error.details?.fields || {}).flat()[0] || error.message || 'unknown error'}`];\n  else if (status === 200 && Array.isArray(body.data?.formatted)) texts = from.route === 'voice' ? [`\\u{1F3A4} _${body.data.transcript}_`, ...body.data.formatted] : body.data.formatted;\n  else texts = ['Something went wrong while answering. Please try again.'];\n\n  for (const text of texts) out.push({ json: { wa_id: from.wa_id, phone_number_id: from.phone_number_id, text } });\n});\n\nreturn out;"
      },
