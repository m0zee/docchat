    {
      "parameters": {
        "jsCode": "// Tells the chat that sent a document whether it is ready. This lands inside\n// WhatsApp's 24-hour reply window, because the person just sent the file.\nconst doc = $('Check signature').first().json.document;\nconst waId = doc?.meta?.chat_id;\nif (!doc || doc.source !== 'whatsapp' || !waId || !doc.meta.phone_number_id) return [];\n\nconst text = doc.status === 'ready'\n  ? `*${doc.title}* is ready (${doc.page_count} ${doc.page_count === 1 ? 'page' : 'pages'}). Ask me about it.`\n  : `I could not read *${doc.title}*: ${doc.error}`;\n\nreturn [{ json: { wa_id: String(waId), phone_number_id: String(doc.meta.phone_number_id), text } }];"
      },
      "id": "2a49a251-fd8d-5c11-83bf-68a08d9cccda",
