        "options": {}
      },
      "id": "a2b5c5cb-3515-5c78-8ac3-e72e68d6ec91",
      "name": "Changed file in folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        80,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Google Docs, Sheets and Slides are exported as PDF. PDF, TXT and Markdown\n// files are downloaded as they are. Everything else is skipped.\nconst nativeTypes = [\n  'application/vnd.google-apps.document',\n  'application/vnd.google-apps.spreadsheet',\n  'application/vnd.google-apps.presentation',\n];\nconst directTypes = { 'application/pdf': 'pdf', 'text/plain': 'txt', 'text/markdown': 'md', 'text/x-markdown': 'md' };\nconst seen = new Set();\nconst files = [];\n\nfor (const item of $input.all()) {\n  const file = item.json;\n  if (!file.id || file.trashed || seen.has(file.id)) continue;\n  seen.add(file.id);\n\n  let extension = null;\n  if (nativeTypes.includes(file.mimeType)) extension = 'pdf';\n  else if (directTypes[file.mimeType]) extension = directTypes[file.mimeType];\n  else if (/\\.(md|markdown)$/i.test(file.name || '')) extension = 'md';\n  if (!extension) continue;\n\n  const title = String(file.name || file.id).replace(/\\.(pdf|txt|md|markdown)$/i, '');\n  files.push({ json: {\n    id: file.id,\n    name: file.name,\n    mimeType: file.mimeType,\n    title,\n    upload_name: `${title}.${extension}`,\n    link: file.webViewLink || `https://drive.google.com/file/d/${file.id}/view`,\n  } });\n}\n\nreturn files;"
      },
      "id": "fcf88f9f-01e7-56af-880b-80bf3c382f71",
      "name": "Pick supported files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        100
      ]
    },
    {
      "parameters": {
