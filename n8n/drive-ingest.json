        }
      },
      "id": "6a2b7ba0-1d68-59c0-9a8a-f71eecb55954",
      "name": "DocChat events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        80,
        520
      ],
      "webhookId": "536b20b1-5240-5170-aa2e-4083da01b66c"
    },
    {
      "parameters": {
        "jsCode": "// Checks DocChat's signature: HMAC-SHA256 of the exact raw body with the\n// webhook secret, plus a 5 minute window on the timestamp against replays.\nconst crypto = require('crypto');\nconst secret = $env.DOCCHAT_WEBHOOK_SECRET;\nconst item = $input.first();\nconst headers = item.json.headers || {};\nlet raw = '';\nif (item.binary && item.binary.data) {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n}\nconst signature = String(headers['x-docchat-signature'] || '');\nconst timestamp = String(headers['x-docchat-timestamp'] || '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', String(secret || '')).update(raw).digest('hex');\nlet body = null;\ntry { body = JSON.parse(raw); } catch (error) { body = null; }\nconst fresh = /^\\d+$/.test(timestamp) && Math.abs(Date.now() / 1000 - Number(timestamp)) <= 300;\nconst valid = Boolean(secret)\n  && signature.length === expected.length\n  && crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected))\n  && fresh\n  && body !== null\n  && String(body.timestamp) === timestamp;\n\nreturn [{ json: { valid, event: body?.event ?? null, document: body?.data?.document ?? null } }];"
      },
      "id": "15efadbe-40a1-5885-ae4d-e2d9a9c49834",
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
