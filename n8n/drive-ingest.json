{
  "id": "dcDriveIngest001",
  "name": "DocChat: Google Drive ingest",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Google Drive to DocChat\nNew and changed files in one Drive folder are uploaded to DocChat with `source=google_drive` and the Drive file id as `external_id`, so a changed file replaces its document.\n\nThe second part receives DocChat's `document.ready` and `document.failed` webhooks, checks the signature, and emails you.\n\nSetup: see `n8n/README.md`.",
        "width": 460,
        "height": 340
      },
      "id": "91852cac-d63f-504f-980e-2376733435c8",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -260
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "event": "fileCreated",
        "options": {}
      },
      "id": "a6eb57b7-89ca-5a62-b45a-f27f6d086998",
      "name": "New file in folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "pollTimes": {
