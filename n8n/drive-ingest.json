            {
              "id": "59ce9dbc-cfd5-5d04-bc08-289db8b52d4b",
              "leftValue": "={{ $('Check signature').item.json.document?.source }}",
              "rightValue": "google_drive",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c06a94d7-07b4-54d9-ab3c-575cd966157b",
      "name": "Only Drive files",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1040,
        420
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.DOCCHAT_NOTIFY_EMAIL }}",
        "subject": "={{ $('Check signature').item.json.event === 'document.ready' ? 'Ready in DocChat: ' : 'DocChat could not read: ' }}{{ $('Check signature').item.json.document.title }}",
        "emailType": "text",
        "message": "={{ $('Check signature').item.json.event === 'document.ready'\n  ? `\"${$('Check signature').item.json.document.title}\" is ready to chat with (${$('Check signature').item.json.document.page_count} pages).`\n  : `\"${$('Check signature').item.json.document.title}\" could not be processed: ${$('Check signature').item.json.document.error}` }}\n\nDrive: {{ $('Check signature').item.json.document.meta?.drive_link ?? '-' }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "8e92f0a1-4272-587b-b5b5-4ca05b177892",
