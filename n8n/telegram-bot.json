    {
      "parameters": {
        "jsCode": "// Turns each DocChat response into Telegram messages (HTML parse mode).\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst notLinked = 'This chat is not linked to a DocChat workspace yet. In DocChat, open <b>Workspace &gt; Chat apps</b>, create a link code, and open the link it gives you.';\nconst help = [\n  '<b>DocChat bot</b>',\n  'Ask a question about your workspace\\'s documents and I answer with sources.',\n  '',\n  '/start CODE: link this chat to a workspace (code from Workspace &gt; Chat apps)',\n  '/new: start a new conversation',\n  '/unlink: unlink this chat',\n  '/help: this message',\n  '',\n  'Send a PDF, TXT or Markdown file in a private chat to add it to the workspace.',\n  'In groups, mention me or reply to me.',\n].join('\\n');\n\nconst out = [];\n\n$input.all().forEach((item, index) => {\nconst from = $('Route').itemMatching(index).json;\nconst status = item.json.statusCode;\nconst body = item.json.body || {};\nconst error = body.error || {};\nlet texts;\nif (from.route === 'help') {\n  texts = [help];\n} else if (error.code === 'chat_not_linked') {\n  texts = [notLinked];\n} else if (status === 429 || error.code === 'model_busy' || error.code === 'rate_limited') {\n  texts = ['The model is busy. Try again in a minute.'];\n} else if (from.route === 'link') {\n  texts = status === 200\n    ? [`Linked to <b>${esc(body.data.workspace.name)}</b>. Ask me anything about its documents.`]\n    : ['That code did not work. It may be used or older than 15 minutes. Create a new one in DocChat.'];\n} else if (from.route === 'start') {\n  texts = body.data?.linked\n    ? [`This chat is linked to <b>${esc(body.data.workspace.name)}</b>. Ask me anything about its documents.`]\n    : [notLinked];\n} else if (from.route === 'new') {\n  texts = ['Started a new conversation.'];\n} else if (from.route === 'unlink') {\n  texts = [body.data?.was_linked ? 'This chat is unlinked.' : 'This chat was not linked.'];\n} else if (from.route === 'document') {\n  texts = status === 202\n    ? [`Got <b>${esc(from.file_name)}</b>. I will tell you when it is ready.`]\n    : [`I could not take that file: ${esc(Object.values(error.details?.fields || {}).flat()[0] || error.message || 'unknown error')}`];\n} else if (status === 200 && Array.isArray(body.data?.formatted)) {\n  texts = body.data.formatted;\n} else {\n  texts = ['Something went wrong while answering. Please try again.'];\n}\n\nfor (const text of texts) {\n  out.push({ json: { chat_id: from.chat_id, text } });\n}\n});\n\nreturn out;"
      },
