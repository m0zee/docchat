    {
      "parameters": {
        "jsCode": "// Tells the chat that sent a document whether it is ready.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst doc = $('Check signature').first().json.document;\nconst chatId = doc?.meta?.chat_id;\nif (!doc || doc.source !== 'telegram' || !chatId) return [];\n\nconst text = doc.status === 'ready'\n  ? `<b>${esc(doc.title)}</b> is ready (${doc.page_count} ${doc.page_count === 1 ? 'page' : 'pages'}). Ask me about it.`\n  : `I could not read <b>${esc(doc.title)}</b>: ${esc(doc.error)}`;\n\nreturn [{ json: { chat_id: String(chatId), text } }];"
      },
      "id": "1d84850b-5748-56a3-b5e4-0fad43be58d0",
      "name": "Document status",
      "type": "n8n-nodes-base.code",
