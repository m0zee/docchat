      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Decides what to do with each Telegram message.\n// In groups the bot only answers commands, @mentions and replies to itself.\nconst bot = String($env.TELEGRAM_BOT_USERNAME || '').replace(/^@/, '').toLowerCase();\nconst message = $json.message || {};\nconst chat = message.chat || {};\nconst text = String(message.text || message.caption || '').trim();\nconst isGroup = chat.type === 'group' || chat.type === 'supergroup';\nconst [first = '', ...rest] = text.split(/\\s+/);\n\nlet command = null;\nif (first.startsWith('/')) {\n  const [name, target] = first.slice(1).split('@');\n  if (!target || !bot || target.toLowerCase() === bot) command = name.toLowerCase();\n}\n\nconst mentioned = bot !== '' && text.toLowerCase().includes('@' + bot);\nconst repliedToBot = bot !== '' && String(message.reply_to_message?.from?.username || '').toLowerCase() === bot;\n\nlet route = 'ignore';\nif (command === 'start') route = rest[0] ? 'link' : 'start';\nelse if (command === 'help') route = 'help';\nelse if (command === 'new') route = 'new';\nelse if (command === 'unlink') route = 'unlink';\nelse if (message.document) route = isGroup ? 'ignore' : 'document';\nelse if (text !== '' && !command && (!isGroup || mentioned || repliedToBot)) route = 'ask';\n\nconst question = bot ? text.replace(new RegExp('@' + bot, 'ig'), '').trim() : text;\nconst name = [message.from?.first_name, message.from?.last_name].filter(Boolean).join(' ');\n\nreturn {\n  json: {\n    route,\n    chat_id: String(chat.id),\n    message_id: message.message_id,\n    is_group: isGroup,\n    link: `telegram:${chat.id}`,\n    code: rest[0] || null,\n    question,\n    label: chat.title || name || chat.username || String(chat.id),\n    file_name: message.document?.file_name || null,\n  },\n  binary: $input.item.binary,\n};"
      },
